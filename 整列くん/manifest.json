{
  "manifest_version": 3,
  "name": "Slides Align Panel",
  "version": "0.2.4",
  "description": "Google スライドの整列・均等配置を画面内のパネルから呼び出す試作版。",
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
